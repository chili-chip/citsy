DLG DLG_ITEMS
{item "key" 2}keys={say {item "key"}}{item "0" {{item "0"} - 1}} now={say {item "0"}}

DLG DLG_VARS
{s = "hello"}{t = s + " world"}{u}{say t} [{say missing}] [{x}]

DLG DLG_LONG
