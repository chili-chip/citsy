DLG DLG_SEQ
"""
{sequence
  - first
  - second{n = n + 1}
  - third and last
}
"""

DLG DLG_CYC
"""
{cycle
  - ping
  - pong
}
"""

DLG DLG_SHUF
"""
{shuffle
  - red
  - green
  - blue
}
"""

DLG DLG_COND
"""
{
  - n > 0 ?
    n is {say n}
  - {item "key"} == 1 ?
    has key
  - else ?
    nothing yet
}
{n == 0 ? "zero" : "some"}
"""

DLG DLG_FX
plain {wvy}wavy{wvy} {clr2}colour{clr2} {rbw}rainbow{rbw} {shk}shake{shk} {drwt "face"} tile{br}next line{pg}new page

DLG DLG_WORLD
